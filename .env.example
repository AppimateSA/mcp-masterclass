# ── Stage 2: deploy to Vercel ────────────────────────────────────────────────
# The server itself needs NO environment variables for stages 1 to 3.
# Copy to .env.local only if you want the values below locally.

# Written by `vercel link` / `vercel env pull` (short-lived; lets local code call
# Vercel services as this project). Never commit the real value.
VERCEL_OIDC_TOKEN=

# Used by the test scripts, not the server (set in your shell, or here):
#   MCP_URL=https://<project>.vercel.app/api/mcp npm run smoke
MCP_URL=
