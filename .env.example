# ── Stage 4: Sign in with Google ─────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#   Application type: Web application
#   Authorised redirect URIs:
#     https://<your-project>.vercel.app/oauth/google/callback
#     http://localhost:3000/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs every code and token this server issues. Generate: openssl rand -base64 48
AUTH_SECRET=

# Recommended in production so the OAuth issuer is stable: https://<your-project>.vercel.app
PUBLIC_BASE_URL=

# Optional: only these Google account domains may sign in (comma separated)
ALLOWED_EMAIL_DOMAINS=

# ── Commercialisation ────────────────────────────────────────────────────────
# Shared store for rate limits, usage and audit. Vercel → Marketplace → Upstash Redis
# sets KV_REST_API_URL / KV_REST_API_TOKEN for you. Without it, an in-memory store is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Workshop shortcut: these emails get the Pro plan (comma separated)
PRO_EMAILS=

# Optional: POST each billable usage event here (your billing service / meter)
BILLING_METER_URL=
BILLING_METER_TOKEN=
